# Copie para .env (nunca versionar o .env). Não deixe chaves em comentários.

# LLM via gateway no formato OpenAI (configs/models.yaml → provider). Sem chave: só regras.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Sobrescritas opcionais de configs/settings.yaml (prefixo CLAIMS_, aninhamento com __)
# CLAIMS_DATA_DIR=data
# CLAIMS_LLM__ENABLED=false
# CLAIMS_LLM__REWRITE_MESSAGES=true
# CLAIMS_TRIAGE__LLM_FALLBACK=false

# LangSmith (opcional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=claims-agents
